@startuml Orchestra_Core_Phase1_LLD

skinparam componentStyle uml2
skinparam Monochrome false
skinparam Shadowing true
skinparam packageStyle Frame

package "Orchestra-Core Monolith (Phase 1)" {

    package "Presentation Layer (Controllers)" {
        class WorkspaceController {
            + saveWorkspace(Workspace): ResponseEntity<?>
            + findWorkspaceById(Long): ResponseEntity<?>
            + updateWorkspace(Long, Workspace): ResponseEntity<?>
            + deleteWorkspace(Long): ResponseEntity<?>
        }

        class TeamController {
            + saveTeam(Team): ResponseEntity<?>
            + findTeamById(Long): ResponseEntity<?>
            + updateTeam(Long, Team): ResponseEntity<?>
            + deleteTeam(Long): ResponseEntity<?>
        }

        class TaskController {
            + saveTask(Task): ResponseEntity<?>
            + findTaskById(Long): ResponseEntity<?>
            + updateTask(Long, Task): ResponseEntity<?>
            + deleteTask(Long): ResponseEntity<?>
        }

        class TaskUpdatesController {
            + saveTaskUpdate(TaskUpdate): ResponseEntity<?>
            + findUpdatesForTask(Long): ResponseEntity<?>
        }
    }

    package "Service Layer (Business Rules & Transactions)" {
        class WorkspaceServices {
            + saveWorkspace(Workspace): void
            + findWorkspaceById(Long): Workspace
            + updateWorkspace(Long, Workspace): void
            + deleteWorkspace(Long): void
        }

        class TeamServices {
            + saveTeam(Team): void
            + findTeamById(Long): Team
            + updateTeam(Long, Team): void
            + deleteTeam(Long): void
        }

        class TaskServices {
            + saveTask(Task): void
            + findTaskById(Long): Task
            + updateTask(Long, Task): void
            + deleteTask(Long): void
        }

        class TaskUpdatesServices {
            + saveTaskUpdate(TaskUpdate): void
            + findUpdatesByTaskId(Long): List<TaskUpdate>
        }
    }

    package "Domain Persistence Layer (JPA Entities)" {
        class Workspace {
            - Id: Long @Id
            - Name: String
            - Description: String
            - Teams: List<Team> @OneToMany(mappedBy = "workspace")
        }

        class Team {
            - Id: Long @Id
            - Name: String
            - Description: String
            - Employees: List<Employee> @OneToMany(mappedBy = "team")
            - workspace: Workspace @ManyToOne
        }

        class Employee {
            - Id: Long @Id
            - Name: String
            - Email: String
            - Password: String
            - Role: Status? /* role enum not present as separate class in code */
            - team: Team @ManyToOne
        }

        class Task {
            - Id: Long @Id
            - Title: String
            - Description: String
            - Status: Status
            - AssignedTo: Employee @OneToOne
            - creationTime: LocalDateTime
            - updates: List<TaskUpdate> @OneToMany(mappedBy = "task")
        }

        class TaskUpdate {
            - Id: Long
            - employee: Employee
            - status: Status
            - task: Task
            - updateTime: LocalDateTime
        }

        enum Status {
            NEW
            ASSIGNED
            IN_PROGRESS
            RESOLVED
            FEEDBACK
            TESTED_LOCALLY
            TESTED_ONLINE
            CLOSED
            ACKNOWLEDGED
            REOPENED
            REJECTED
        }
    }


    package "Data Access Layer (Repositories)" {
        class WorkspaceRepository {
            + saveWorkspace(Workspace): void
            + findWorkspaceById(Long): Workspace
            + deleteWorkspace(Workspace): void
        }

        class TeamRepository {
            + saveTeam(Team): void
            + findTeamById(Long): Team
            + deleteTeam(Team): void
        }

        class TaskRepository {
            + saveTask(Task): void
            + findTaskById(Long): Task
            + deleteTask(Task): void
        }

        class TaskUpdatesRepository {
            + saveTaskUpdate(TaskUpdate): void
            + findByTaskId(Long): List<TaskUpdate>
        }
    }
}

WorkspaceController --> WorkspaceServices
WorkspaceServices --> WorkspaceRepository
WorkspaceServices --> Workspace
Workspace "1" *-- "0..*" Team : @OneToMany
Team "1" *-- "0..*" Employee : @OneToMany
Employee --> Status
Task --> Status
Task "1" o-- "0..1" Employee : AssignedTo @OneToOne
Task "1" *-- "0..*" TaskUpdate : updates

@enduml
