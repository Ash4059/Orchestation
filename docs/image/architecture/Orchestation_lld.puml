@startuml Orchestra_Core_Phase1_LLD

skinparam componentStyle uml2
skinparam Monochrome false
skinparam Shadowing true
skinparam packageStyle Frame

package "Orchestra-Core Monolith (Phase 1)" {

    package "Presentation Layer (Controllers)" {
        class WorkspaceController {
            + createWorkspace(CreateWorkspaceRequest): ResponseEntity<WorkspaceResponse>
            + getWorkspaceById(UUID): ResponseEntity<WorkspaceResponse>
            + updateWorkspace(UUID, UpdateWorkspaceRequest): ResponseEntity<WorkspaceResponse>
            + deleteWorkspace(UUID): ResponseEntity<Void>
        }

        class TeamController {
            + createTeam(UUID, CreateTeamRequest): ResponseEntity<TeamResponse>
            + addMemberToTeam(UUID, AddMemberRequest): ResponseEntity<TeamResponse>
        }

        class TaskController {
            + createTask(UUID, CreateTaskRequest): ResponseEntity<TaskResponse>
            + updateTaskStatus(UUID, TaskStatus): ResponseEntity<TaskResponse>
        }
    }

    package "DTO Layer (Request / Response Wrappers)" {
        class CreateWorkspaceRequest {
            - name: String @NotBlank
            - description: String
            - ownerId: UUID @NotNull
        }
        class WorkspaceResponse {
            - id: UUID
            - name: String
            - description: String
            - teamsCount: int
            - createdAt: LocalDateTime
        }
    }

    package "Service Layer (Business Rules & Transactions)" {
        interface WorkspaceService {
            + createWorkspace(CreateWorkspaceRequest): WorkspaceResponse
            + getWorkspaceById(UUID): WorkspaceResponse
        }
        
        class WorkspaceServiceImpl implements WorkspaceService {
            - workspaceRepository: WorkspaceRepository
            - userRepository: UserRepository
            - workspaceMapper: WorkspaceMapper
            + @Transactional createWorkspace(req): WorkspaceResponse
        }
    }

    package "Domain Persistence Layer (JPA Entities)" {
        class Workspace {
            - Id: UUID @Id
            - Name: String
            - Description: String
            - Teams: List<Team> @OneToMany
        }

        class Team {
            - Id: UUID @Id
            - Name: String
            - Description: String
            - Employees: List<Employee> @OneToMany
            - workspace: Workspace @ManyToOne
        }

        class Employee {
            - Id: String @Id
            - Name: String
            - Email: String
            - Password: String
            - Role: Role
            - DateOfBirth: LocalDate
            - DateOfJoining: LocalDate
            - team: Team @ManyToOne
        }

        class Task {
            - Id: UUID @Id
            - Title: String
            - Description: String
            - Status: Status
            - AssignedTo: Employee @OneToOne
            - creationTime: LocalDateTime
            - updates: Updates @OneToMany
        }

        class Updates {
            - Id: UUID @Id
            - employee: Employee @OneToOne
            - status: Status
            - task: Task @ManyToOne
            - updateTime: LocalDateTime
        }

        enum Role {
            ADMIN
            USER
            MANAGER
            DEVELOPER
            SENIOR_DEVELOPER
            TESTER
            SENIOR_TESTER
            DESIGNER
            SENIOR_DESIGNER
            MODULE_LEAD
            PROJECT_MANAGER
            TEAM_LEAD
        }

        enum Status {
            NEW
            ASSIGNED
            IN_PROGRESS
            RESOLVED
            FEEDBACK
            TESTED_LOCALLY
            TESTED_ONLINE
            CLOSED
            ACKNOWLEDGED
            REOPENED
            REJECTED
        }
    }

    package "Data Access Layer (Spring Data Repositories)" {
        interface WorkspaceRepository {
            + findByName(String): Optional<WorkspaceEntity>
            + findWorkspaceWithTeamsAndMembersById(UUID): Optional<WorkspaceEntity>
        }
    }
}

WorkspaceController --> WorkspaceService
WorkspaceServiceImpl --> WorkspaceRepository
WorkspaceServiceImpl --> Workspace
Workspace "1" *-- "0..*" Team : @OneToMany
Team "1" *-- "0..*" Employee : @OneToMany
Employee --> Role
Task --> Status
Task "1" o-- "0..1" Employee : AssignedTo @OneToOne
Task "1" *-- "0..*" Updates : @OneToMany
Updates --> Employee
Updates --> Task

@enduml
